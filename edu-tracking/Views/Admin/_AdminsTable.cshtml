@model AdminsPageViewModel

<section class="card-soft">
    <form class="toolbar" method="get" asp-action="Admins">
        <div class="admin-search me-auto">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Filter.Search"
                   placeholder="Search name, username or email..." aria-label="Search admins" />
        </div>

        <select class="form-select" name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in AccountStatus.All)
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
            }
        </select>

        <button class="btn btn-admin-outline" type="submit">Apply</button>
        <a class="btn btn-admin-outline" asp-action="Admins">Reset</a>
    </form>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Admin</th>
                    <th>Username</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Admins.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">
                            No admins found.
                            <a asp-action="CreateAdmin">Add one</a>.
                        </td>
                    </tr>
                }

                @foreach (var admin in Model.Admins)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials tone-blue">@Ui.Initials(admin.Name)</span>
                                <span>
                                    <span class="d-block fw-semibold">
                                        @admin.Name
                                        @if (admin.IsCurrentUser)
                                        {
                                            <span class="badge-soft tone-gray ms-1">You</span>
                                        }
                                    </span>
                                    <span class="text-secondary small">@admin.Email</span>
                                </span>
                            </div>
                        </td>
                        <td class="text-secondary">@admin.UserName</td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(admin.Phone) ? "—" : admin.Phone)</td>
                        <td><span class="badge-soft tone-@Ui.StatusTone(admin.Status)">@admin.Status</span></td>
                        <td class="text-secondary text-nowrap">@admin.JoinedUtc.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                        aria-label="Actions for @admin.Name">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="EditAdmin" asp-route-id="@admin.Id">
                                            <i class="bi bi-pencil me-2"></i>Edit
                                        </a>
                                    </li>

                                    @if (!admin.IsCurrentUser)
                                    {
                                        <li>
                                            <form asp-action="ResetAdminPassword" method="post">
                                                <input type="hidden" name="id" value="@admin.Id" />
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bi bi-key me-2"></i>Reset password
                                                </button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }

                                    @if (Model.CanDeactivate(admin))
                                    {
                                        <li>
                                            <form asp-action="SetAdminActive" method="post">
                                                <input type="hidden" name="id" value="@admin.Id" />
                                                <input type="hidden" name="isActive" value="False" />
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else if (!admin.IsActive)
                                    {
                                        <li>
                                            <form asp-action="SetAdminActive" method="post">
                                                <input type="hidden" name="id" value="@admin.Id" />
                                                <input type="hidden" name="isActive" value="True" />
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bi bi-check2-circle me-2"></i>Reactivate
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <span class="dropdown-item-text text-secondary small">
                                                @(admin.IsCurrentUser
                                                    ? "You cannot deactivate yourself"
                                                    : "The last active admin must stay")
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span class="text-secondary small">
            Showing @Model.Page.FirstShown–@Model.Page.LastShown of @Model.Page.TotalItems admins
        </span>

        @if (Model.Page.TotalPages > 1)
        {
            <nav aria-label="Admin pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page.Current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Admins"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current - 1)">Previous</a>
                    </li>

                    @* Named pageNumber, not page: Razor would read "@page" as the page directive. *@
                    @for (var pageNumber = 1; pageNumber <= Model.Page.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page.Current ? "active" : "")">
                            <a class="page-link" asp-action="Admins"
                               asp-all-route-data="Model.Filter.ToRouteValues(pageNumber)">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page.Current == Model.Page.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Admins"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

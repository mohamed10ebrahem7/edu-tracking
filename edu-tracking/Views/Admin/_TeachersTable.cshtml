@model TeachersPageViewModel

<section class="card-soft">
    <form class="toolbar" method="get" asp-action="Teachers">
        <div class="admin-search me-auto">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Filter.Search"
                   placeholder="Search name, username or email..." aria-label="Search teachers" />
        </div>

        <select class="form-select" name="subjectId" aria-label="Filter by subject">
            <option value="">All subjects</option>
            @foreach (var subject in Model.Subjects)
            {
                <option value="@subject.Id" selected="@(Model.Filter.SubjectId == subject.Id)">@subject.Name</option>
            }
        </select>

        <select class="form-select" name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in TeachersPageViewModel.StatusOptions)
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
            }
        </select>

        <button class="btn btn-admin-outline" type="submit">Apply</button>
        <a class="btn btn-admin-outline" asp-action="Teachers">Reset</a>
    </form>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Teacher</th>
                    <th>Subjects</th>
                    <th>Hourly Rate</th>
                    <th>Students</th>
                    <th>Sessions / Week</th>
                    <th>Bookings</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Teachers.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-5">
                            No teachers found.
                            <a asp-action="CreateTeacher">Add the first one</a>.
                        </td>
                    </tr>
                }

                @foreach (var teacher in Model.Teachers)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials tone-green">@Ui.Initials(teacher.Name)</span>
                                <span>
                                    <span class="d-block fw-semibold">@teacher.Name</span>
                                    <span class="text-secondary small">@teacher.Email</span>
                                </span>
                            </div>
                        </td>
                        <td>
                            @if (teacher.Subjects.Count == 0)
                            {
                                <span class="text-secondary small">—</span>
                            }
                            @foreach (var subject in teacher.Subjects)
                            {
                                <span class="subject-chip">@subject</span>
                            }
                        </td>
                        <td class="fw-semibold text-nowrap">EGP @teacher.HourlyRate.ToString("N0")</td>
                        <td class="text-secondary">@teacher.Students</td>
                        <td class="text-secondary">@teacher.SessionsThisWeek</td>
                        <td>
                            @if (teacher.AcceptingBookings)
                            {
                                <span class="badge-soft tone-green">Open</span>
                            }
                            else
                            {
                                <span class="badge-soft tone-gray">Closed</span>
                            }
                        </td>
                        <td><span class="badge-soft tone-@Ui.StatusTone(teacher.Status)">@teacher.Status</span></td>
                        <td class="text-secondary text-nowrap">@teacher.JoinedUtc.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                        aria-label="Actions for @teacher.Name">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="EditTeacher" asp-route-id="@teacher.Id">
                                            <i class="bi bi-pencil me-2"></i>Edit
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-action="ResetTeacherPassword" method="post">
                                            <input type="hidden" name="id" value="@teacher.Id" />
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-key me-2"></i>Reset password
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-action="SetTeacherActive" method="post">
                                            <input type="hidden" name="id" value="@teacher.Id" />
                                            <input type="hidden" name="isActive" value="@((!teacher.IsActive).ToString())" />
                                            @if (teacher.IsActive)
                                            {
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bi bi-check2-circle me-2"></i>Reactivate
                                                </button>
                                            }
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span class="text-secondary small">
            Showing @Model.Page.FirstShown–@Model.Page.LastShown of @Model.Page.TotalItems teachers
        </span>

        @if (Model.Page.TotalPages > 1)
        {
            <nav aria-label="Teacher pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page.Current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Teachers"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current - 1)">Previous</a>
                    </li>

                    @* Named pageNumber, not page: Razor would read "@page" as the page directive. *@
                    @for (var pageNumber = 1; pageNumber <= Model.Page.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page.Current ? "active" : "")">
                            <a class="page-link" asp-action="Teachers"
                               asp-all-route-data="Model.Filter.ToRouteValues(pageNumber)">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page.Current == Model.Page.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Teachers"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

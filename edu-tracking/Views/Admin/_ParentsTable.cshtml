@model ParentsPageViewModel

<section class="card-soft">
    <form class="toolbar" method="get" asp-action="Parents">
        <div class="admin-search me-auto">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Filter.Search"
                   placeholder="Search parent or child name..." aria-label="Search parents" />
        </div>

        <select class="form-select" name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in AccountStatus.All)
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
            }
        </select>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="withoutChildren" value="true"
                   id="withoutChildren" checked="@(Model.Filter.WithoutChildren == true)" />
            <label class="form-check-label small text-nowrap" for="withoutChildren">No child linked</label>
        </div>

        <button class="btn btn-admin-outline" type="submit">Apply</button>
        <a class="btn btn-admin-outline" asp-action="Parents">Reset</a>
    </form>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Parent</th>
                    <th>Children</th>
                    <th>Relationship</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Parents.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            No parents found.
                            <a asp-action="CreateParent">Add the first one</a>.
                        </td>
                    </tr>
                }

                @foreach (var parent in Model.Parents)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials tone-orange">@Ui.Initials(parent.Name)</span>
                                <span>
                                    <span class="d-block fw-semibold">@parent.Name</span>
                                    <span class="text-secondary small">@parent.Email</span>
                                </span>
                            </div>
                        </td>
                        <td>
                            @if (parent.Children.Count == 0)
                            {
                                <span class="text-secondary small">None linked</span>
                            }
                            @foreach (var child in parent.Children)
                            {
                                <span class="subject-chip">
                                    @child.Name
                                    @if (child.IsPrimaryContact)
                                    {
                                        <i class="bi bi-star-fill ms-1" title="Primary contact"></i>
                                    }
                                </span>
                            }
                        </td>
                        <td class="text-secondary">@parent.Relationships</td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(parent.Phone) ? "—" : parent.Phone)</td>
                        <td><span class="badge-soft tone-@Ui.StatusTone(parent.Status)">@parent.Status</span></td>
                        <td class="text-secondary text-nowrap">@parent.JoinedUtc.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                        aria-label="Actions for @parent.Name">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="EditParent" asp-route-id="@parent.Id">
                                            <i class="bi bi-pencil me-2"></i>Edit
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-action="ResetParentPassword" method="post">
                                            <input type="hidden" name="id" value="@parent.Id" />
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-key me-2"></i>Reset password
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-action="SetParentActive" method="post">
                                            <input type="hidden" name="id" value="@parent.Id" />
                                            <input type="hidden" name="isActive" value="@((!parent.IsActive).ToString())" />
                                            @if (parent.IsActive)
                                            {
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bi bi-check2-circle me-2"></i>Reactivate
                                                </button>
                                            }
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span class="text-secondary small">
            Showing @Model.Page.FirstShown–@Model.Page.LastShown of @Model.Page.TotalItems parents
        </span>

        @if (Model.Page.TotalPages > 1)
        {
            <nav aria-label="Parent pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page.Current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Parents"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current - 1)">Previous</a>
                    </li>

                    @* Named pageNumber, not page: Razor would read "@page" as the page directive. *@
                    @for (var pageNumber = 1; pageNumber <= Model.Page.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page.Current ? "active" : "")">
                            <a class="page-link" asp-action="Parents"
                               asp-all-route-data="Model.Filter.ToRouteValues(pageNumber)">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page.Current == Model.Page.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Parents"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

@model ParentFormViewModel
@{
    var isEdit = Model.IsEdit;
    ViewData["Title"] = isEdit ? "Edit parent" : "Add parent";
    ViewData["ActiveNav"] = "parents";
}

<div class="mb-3">
    <div class="crumbs mb-1">
        <a asp-action="Index">Dashboard</a> / <a asp-action="Parents">Parents</a> / @(isEdit ? "Edit" : "New")
    </div>
    <h1 class="h5 fw-bold mb-0">@(isEdit ? $"Edit {Model.FullName}" : "Add New Parent")</h1>
    <span class="text-secondary small">
        @(isEdit
            ? "Update the account and the children this parent follows."
            : "Creates the login, assigns the Parent role and links the children.")
    </span>
</div>

<form asp-action="@(isEdit ? "EditParent" : "CreateParent")" method="post" class="card-soft p-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label small fw-semibold"></label>
            <input asp-for="FullName" class="form-control" placeholder="Nadia Hassan" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="UserName" class="form-label small fw-semibold"></label>
            @if (isEdit)
            {
                @* The login name is fixed so a parent's sign-in never changes underneath them. *@
                <input class="form-control" value="@Model.UserName" disabled />
                <input type="hidden" asp-for="UserName" />
                <span class="text-secondary small">The username cannot be changed.</span>
            }
            else
            {
                <input asp-for="UserName" class="form-control" placeholder="nadia.hassan" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            }
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label small fw-semibold"></label>
            <input asp-for="Email" class="form-control" placeholder="nadia.h@email.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
            <span class="text-secondary small">Reports and session notices go here.</span>
        </div>

        <div class="col-md-6">
            <label asp-for="Phone" class="form-label small fw-semibold"></label>
            <input asp-for="Phone" class="form-control" placeholder="+20 100 000 0000" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label class="form-label small fw-semibold">Children</label>
            @if (Model.AvailableStudents.Count == 0)
            {
                <div class="text-secondary small">
                    No student accounts yet. Create students first, then link them here.
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var student in Model.AvailableStudents)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="StudentIds" value="@student.Id"
                                   id="student-@student.Id" checked="@Model.StudentIds.Contains(student.Id)" />
                            <label class="form-check-label small" for="student-@student.Id">
                                @student.Name <span class="text-secondary">(@student.Grade)</span>
                            </label>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-md-4">
            <label asp-for="Relationship" class="form-label small fw-semibold"></label>
            <select asp-for="Relationship" class="form-select">
                @foreach (var relationship in ParentRelationship.All)
                {
                    <option value="@relationship">@relationship</option>
                }
            </select>
            <span asp-validation-for="Relationship" class="text-danger small"></span>
        </div>

        <div class="col-md-8 d-flex align-items-end">
            <div class="form-check form-switch">
                <input asp-for="IsPrimaryContact" class="form-check-input" role="switch" />
                <label asp-for="IsPrimaryContact" class="form-check-label small"></label>
                <span class="text-secondary small d-block">
                    Every child has exactly one primary contact, so turning this on takes it over
                    from their other guardians.
                </span>
            </div>
        </div>

        @if (!isEdit)
        {
            <div class="col-md-6">
                <label asp-for="TemporaryPassword" class="form-label small fw-semibold"></label>
                <input asp-for="TemporaryPassword" class="form-control" placeholder="Leave blank to generate one" />
                <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                <span class="text-secondary small d-block">
                    The parent is asked to change it after signing in.
                </span>
            </div>
        }
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-panel-outline" asp-action="Parents">Cancel</a>
        <button class="btn btn-panel" type="submit">@(isEdit ? "Save changes" : "Create parent")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

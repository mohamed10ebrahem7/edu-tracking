@model ParentsPageViewModel
@{
    ViewData["Title"] = "Parents";
    ViewData["CurrentUserName"] = Model.CurrentUserName;
    ViewData["ActiveNav"] = "parents";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <div class="crumbs mb-1">
            <a asp-action="Index">Dashboard</a> / Users / Parents
        </div>
        <h1 class="h5 fw-bold mb-0">Parents</h1>
        <span class="text-secondary small">Manage parent accounts and the children they follow</span>
    </div>

    <a class="btn btn-panel" asp-action="CreateParent">
        <i class="bi bi-plus-lg me-1"></i> Add New Parent
    </a>
</div>

<partial name="Panel/_StatCards" model="Model.Stats" />

<div class="mt-3">
    <partial name="_ParentsTable" model="Model" />
</div>

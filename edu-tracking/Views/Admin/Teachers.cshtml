@model TeachersPageViewModel
@{
    ViewData["Title"] = "Teachers";
    ViewData["CurrentUserName"] = Model.CurrentUserName;
    ViewData["ActiveNav"] = "teachers";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <div class="crumbs mb-1">
            <a asp-action="Index">Dashboard</a> / Users / Teachers
        </div>
        <h1 class="h5 fw-bold mb-0">Teachers</h1>
        <span class="text-secondary small">Manage teacher accounts, subjects and availability</span>
    </div>

    <a class="btn btn-admin" asp-action="CreateTeacher">
        <i class="bi bi-plus-lg me-1"></i> Add New Teacher
    </a>
</div>

<partial name="_StatCards" model="Model.Stats" />

<div class="mt-3">
    <partial name="_TeachersTable" model="Model" />
</div>

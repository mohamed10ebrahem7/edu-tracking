@model StudentsPageViewModel

<section class="card-soft">
    <form class="toolbar" method="get" asp-action="Students">
        <div class="panel-search me-auto">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Filter.Search"
                   placeholder="Search name, username, email or school..." aria-label="Search students" />
        </div>

        <select class="form-select" name="gradeLevel" aria-label="Filter by grade">
            <option value="">All grades</option>
            @foreach (var grade in StudentsPageViewModel.AllGrades)
            {
                <option value="@grade.Value" selected="@((int?)Model.Filter.GradeLevel == grade.Value)">@grade.Label</option>
            }
        </select>

        <select class="form-select" name="status" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in AccountStatus.All)
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
            }
        </select>

        <button class="btn btn-panel-outline" type="submit">Apply</button>
        <a class="btn btn-panel-outline" asp-action="Students">Reset</a>
    </form>

    <div class="table-responsive">
        <table class="panel-table">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Grade</th>
                    <th>School</th>
                    <th>Guardians</th>
                    <th>Sessions / Week</th>
                    <th>Attendance</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Students.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-5">
                            No students found.
                            <a asp-action="CreateStudent">Add the first one</a>.
                        </td>
                    </tr>
                }

                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-initials tone-purple">@Ui.Initials(student.Name)</span>
                                <span>
                                    <span class="d-block fw-semibold">@student.Name</span>
                                    <span class="text-secondary small">@student.Email</span>
                                </span>
                            </div>
                        </td>
                        <td><span class="badge-soft tone-blue">@student.Grade</span></td>
                        <td class="text-secondary">@(string.IsNullOrWhiteSpace(student.School) ? "—" : student.School)</td>
                        <td>
                            @if (student.Guardians.Count == 0)
                            {
                                <span class="text-secondary small">None linked</span>
                            }
                            @foreach (var guardian in student.Guardians)
                            {
                                <span class="subject-chip">@guardian</span>
                            }
                        </td>
                        <td class="text-secondary">@student.SessionsThisWeek</td>
                        <td>
                            @if (student.AttendanceRate is int rate)
                            {
                                <span class="fw-semibold">@rate%</span>
                                <span class="text-secondary small">(@student.AttendanceMarked marked)</span>
                            }
                            else
                            {
                                <span class="text-secondary small">—</span>
                            }
                        </td>
                        <td><span class="badge-soft tone-@Ui.StatusTone(student.Status)">@student.Status</span></td>
                        <td class="text-secondary text-nowrap">@student.JoinedUtc.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="icon-button" type="button" data-bs-toggle="dropdown"
                                        aria-label="Actions for @student.Name">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="EditStudent" asp-route-id="@student.Id">
                                            <i class="bi bi-pencil me-2"></i>Edit
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-action="ResetStudentPassword" method="post">
                                            <input type="hidden" name="id" value="@student.Id" />
                                            <button class="dropdown-item" type="submit">
                                                <i class="bi bi-key me-2"></i>Reset password
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-action="SetStudentActive" method="post">
                                            <input type="hidden" name="id" value="@student.Id" />
                                            <input type="hidden" name="isActive" value="@((!student.IsActive).ToString())" />
                                            @if (student.IsActive)
                                            {
                                                <button class="dropdown-item text-danger" type="submit">
                                                    <i class="bi bi-slash-circle me-2"></i>Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="dropdown-item" type="submit">
                                                    <i class="bi bi-check2-circle me-2"></i>Reactivate
                                                </button>
                                            }
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span class="text-secondary small">
            Showing @Model.Page.FirstShown–@Model.Page.LastShown of @Model.Page.TotalItems students
        </span>

        @if (Model.Page.TotalPages > 1)
        {
            <nav aria-label="Student pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page.Current == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Students"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current - 1)">Previous</a>
                    </li>

                    @* Named pageNumber, not page: Razor would read "@page" as the page directive. *@
                    @for (var pageNumber = 1; pageNumber <= Model.Page.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page.Current ? "active" : "")">
                            <a class="page-link" asp-action="Students"
                               asp-all-route-data="Model.Filter.ToRouteValues(pageNumber)">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.Page.Current == Model.Page.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Students"
                           asp-all-route-data="Model.Filter.ToRouteValues(Model.Page.Current + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

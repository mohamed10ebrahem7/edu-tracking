@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["CurrentUserName"] = Model.CurrentUserName;
}

<div class="d-flex align-items-baseline gap-2 mb-3">
    <h1 class="h5 fw-bold mb-0">Dashboard</h1>
    <span class="text-secondary small">Overview of your institution</span>
</div>

<partial name="_StatCards" model="Model.Stats" />

<div class="row g-3 mt-1">
    <div class="col-xl-4 col-lg-6">
        <partial name="_UserDistribution" model="Model.Distribution" />
    </div>
    <div class="col-xl-4 col-lg-6">
        <partial name="_RecentActivities" model="Model.RecentActivities" />
    </div>
    <div class="col-xl-4">
        <partial name="_SystemOverview" model="Model.SystemOverview" />
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-xl-8">
        <partial name="_RecentUsers" model="Model.RecentUsers" />
    </div>
    <div class="col-xl-4">
        <partial name="_QuickActions" model="Model.QuickActions" />
    </div>
</div>

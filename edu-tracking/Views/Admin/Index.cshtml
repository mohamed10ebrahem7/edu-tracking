@{
    ViewData["Title"] = "Admin panel";
}

<h1 class="h4 mb-4">Admin panel</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Users</h2>
                <p class="text-muted small mb-0">Create admins, teachers, parents and students.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Subjects</h2>
                <p class="text-muted small mb-0">Manage the subject list and teacher assignments.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Parents &amp; students</h2>
                <p class="text-muted small mb-0">Link guardians to their children.</p>
            </div>
        </div>
    </div>
</div>

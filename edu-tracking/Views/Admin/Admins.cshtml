@model AdminsPageViewModel
@{
    ViewData["Title"] = "Admins";
    ViewData["CurrentUserName"] = Model.CurrentUserName;
    ViewData["ActiveNav"] = "admins";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <div class="crumbs mb-1">
            <a asp-action="Index">Dashboard</a> / Users / Admins
        </div>
        <h1 class="h5 fw-bold mb-0">Admins</h1>
        <span class="text-secondary small">Manage the accounts that can reach this panel</span>
    </div>

    <a class="btn btn-admin" asp-action="CreateAdmin">
        <i class="bi bi-plus-lg me-1"></i> Add New Admin
    </a>
</div>

<partial name="_StatCards" model="Model.Stats" />

<div class="mt-3">
    <partial name="_AdminsTable" model="Model" />
</div>

@model IReadOnlyList<QuickAction>

<section class="card-soft h-100">
    <div class="card-soft-header">
        <h2 class="card-soft-title">Quick Actions</h2>
    </div>

    <div class="mt-2">
        @foreach (var action in Model)
        {
            <a class="action-row" href="#">
                <span class="icon-bubble icon-bubble-sm tone-@action.Tone"><i class="bi @action.Icon"></i></span>
                <span class="flex-grow-1">@action.Label</span>
                <i class="bi bi-chevron-right text-secondary small"></i>
            </a>
        }
    </div>
</section>

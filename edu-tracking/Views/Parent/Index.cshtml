@{
    ViewData["Title"] = "Parent panel";
}

<h1 class="h4 mb-4">Parent panel</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">My children</h2>
                <p class="text-muted small mb-0">Sessions booked and upcoming.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Attendance &amp; reports</h2>
                <p class="text-muted small mb-0">What was covered in each session.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Exam marks</h2>
                <p class="text-muted small mb-0">Results per subject.</p>
            </div>
        </div>
    </div>
</div>

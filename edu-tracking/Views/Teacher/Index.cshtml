@{
    ViewData["Title"] = "Teacher panel";
}

<h1 class="h4 mb-4">Teacher panel</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">My schedule</h2>
                <p class="text-muted small mb-0">Available, unavailable and booked slots.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Booking requests</h2>
                <p class="text-muted small mb-0">Approve or decline requests from students.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Attendance &amp; reports</h2>
                <p class="text-muted small mb-0">Mark attendance and write session reports.</p>
            </div>
        </div>
    </div>
</div>

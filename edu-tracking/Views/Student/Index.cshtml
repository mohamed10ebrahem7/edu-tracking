@{
    ViewData["Title"] = "Student panel";
}

<h1 class="h4 mb-4">Student panel</h1>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">My sessions</h2>
                <p class="text-muted small mb-0">Upcoming and past lessons.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Find a session</h2>
                <p class="text-muted small mb-0">Request a seat with any teacher.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6">Reports &amp; marks</h2>
                <p class="text-muted small mb-0">Attendance, feedback and exam results.</p>
            </div>
        </div>
    </div>
</div>
